    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^17.2.3",
    "lucide-react": "0.452.0",
    "next": "^15.5.21",
    "openai": "^6.10.0",
    "pg": "^8.18.0",
    "qs": "^6.15.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^3.8.1",
    "resend": "^6.18.1",
    "stripe": "^22.1.0",
    "twilio": "^5.13.1",
    "uuid": "^13.0.2",
    "zod": "^4.3.6"
